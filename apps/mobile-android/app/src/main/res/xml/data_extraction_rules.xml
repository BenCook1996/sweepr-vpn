<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) cloud backup & device-transfer rules.
    Explicitly exclude sweepr_vpn_prefs.xml so device-bound WireGuard private keys,
    activation keys, and refresh tokens are never uploaded to cloud backup or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sweepr_vpn_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sweepr_vpn_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
